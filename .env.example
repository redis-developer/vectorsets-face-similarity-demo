NODE_ENV=production
REDIS_URL=redis://localhost:6379   # Heroku: set to Redis Cloud URL (rediss://...)
GEMINI_API_KEY=            # Required for upload search; get from https://aistudio.google.com/
PORT=3000                  # Heroku: do not set — platform injects PORT
BASE_PATH=
IMAGE_PREFIX=              # optional, defaults to GCS bucket
CORS_ORIGINS=              # empty = same-origin only; set http://localhost:5173 for direct dev client
FRAME_ANCESTORS=https://redis.io,http://localhost:3000   # iframe embed allowlist; empty = block all embedding
